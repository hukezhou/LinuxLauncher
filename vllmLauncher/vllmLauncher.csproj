<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>vllmLauncher.ico</ApplicationIcon>
    <AssemblyName>LinuxLauncher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="vllmLauncher.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
