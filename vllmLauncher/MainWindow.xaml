<Window x:Class="vllmLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linux Launcher" Icon="vllmLauncher.ico"
        Height="750" Width="1100"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Model Card Item Template -->
        <DataTemplate x:Key="ModelItemTemplate">
            <Border x:Name="CardBorder" CornerRadius="6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectedBg}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Focusable="False"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             FontWeight="Medium"
                             Foreground="{StaticResource Gray800}"
                             VerticalAlignment="Center"
                             Padding="14,6"
                             Margin="0,0,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">
                        <Button Content="x" Command="{Binding DeleteCommand}" Style="{StaticResource TextBtn}" Padding="6,4" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Selected Item Container Style -->
        <Style x:Key="ModelListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title with Settings Button -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Linux Launcher" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gray900}" HorizontalAlignment="Center"/>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙" FontSize="18" Style="{StaticResource TextBtn}" Padding="8,4" Click="SettingsButton_Click" ToolTip="Settings" HorizontalAlignment="Right"/>
        </Grid>

        <!-- SSH Panel -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Server -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Server" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Padding="14,4" FontSize="13" ToolTip="e.g., myuser@192.168.1.10 or myuser@[2001:db8::1]"/>
                    <Button Grid.Column="2" Content="连接" Click="ConnectButton_Click" Style="{StaticResource PrimaryBtn}" Padding="16,4" Margin="8,0,0,0"/>
                </Grid>

                <!-- Options -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding UseScreen, Mode=TwoWay}" Content="持久化" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Kill All vLLM" Command="{Binding KillAllCommand}" Style="{StaticResource DangerBtn}" Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Panel -->
        <Border x:Name="SettingsPanel" Grid.Row="1" Background="White" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Gray800}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="黏贴等待时间(秒)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBox x:Name="PasteWaitTimeTextBox" Grid.Column="1" Text="{Binding PasteWaitTime, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Style="{StaticResource InputBox}" Padding="12,4" FontSize="13" PreviewTextInput="PasteWaitTimeTextBox_PreviewTextInput"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备份配置" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="备份" Command="{Binding BackupCommand}" Style="{StaticResource OutlineBtn}" Padding="12,4" FontSize="12" HorizontalAlignment="Left" ToolTip="备份 config.json 为 config.json.bak"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Content: Model List + Editor -->
        <Grid x:Name="MainContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Model List -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="8" Padding="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型列表" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Gray800}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ 添加" Command="{Binding AddModelCommand}" Style="{StaticResource AddBtn}" Padding="10,4"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ModelList"
                                 ItemsSource="{Binding Models}"
                                 SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ModelItemTemplate}"
                                 ItemContainerStyle="{StaticResource ModelListBoxItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 PreviewMouseDown="ModelList_PreviewMouseDown"
                                 DragOver="ListBox_DragOver"
                                 Drop="ListBox_Drop"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Draggable divider -->
            <Rectangle x:Name="SplitterBorder" Grid.Column="1" Width="6"
                       HorizontalAlignment="Center"
                       Fill="Transparent"
                       MouseLeftButtonDown="Splitter_MouseLeftButtonDown"
                       PreviewMouseMove="Splitter_PreviewMouseMove"
                       PreviewMouseUp="Splitter_PreviewMouseUp"
                       MouseEnter="Splitter_MouseEnter"
                       MouseLeave="Splitter_MouseLeave"/>

            <!-- Right: Editor Panel -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Gray200}" BorderThickness="1" CornerRadius="8" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="模型配置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Gray800}" Margin="0,0,0,12"/>

                    <!-- Full Script -->
                    <TextBlock DockPanel.Dock="Top" Text="启动脚本 (环境变量 + 启动命令)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <Border DockPanel.Dock="Bottom" MinHeight="300" Background="White" CornerRadius="6"
                            BorderBrush="{StaticResource Gray300}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditorActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RichTextBox x:Name="ScriptEditor"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AcceptsTab="True"
                                 IsDocumentEnabled="True"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto"
                                 ContextMenuOpening="EditorContextMenu_Opening"
                                 FontFamily="Consolas"
                                 FontSize="12">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="Cut" Header="剪切"/>
                                    <MenuItem Command="Copy" Header="复制"/>
                                    <MenuItem Command="Paste" Header="粘贴"/>
                                    <Separator/>
                                    <MenuItem x:Name="CommandToggleMenuItem" Header="命令" Click="CommandToggle_Click"/>
                                    <MenuItem x:Name="CollapseToggleMenuItem" Header="卷起" Click="CollapseToggle_Click"/>
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
